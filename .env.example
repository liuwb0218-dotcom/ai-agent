# ===== 模型后端 =====
# 可选值：openai | ollama
MODEL_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# 低温度保证工具调用稳定
LLM_TEMPERATURE=0.3

# ===== 存储（Redis 5.x 需 protocol=2，不支持 RESP3） =====
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PROTOCOL=2
SESSION_TTL=1800

# ===== 服务 =====
HOST=127.0.0.1
PORT=8082
LOG_LEVEL=INFO

# ===== 会话窗口（防上下文超限） =====
MAX_HISTORY_MESSAGES=20
MAX_CONTEXT_TOKENS=8000

# ===== 工具调用 =====
TOOL_RETRY_TIMES=1
TOOL_TIMEOUT=10
LLM_TIMEOUT=30

# ===== 意图识别与知识库路由 =====
# rag-qa-system 服务地址（独立端口），knowledge 意图时转发；留空则返回降级提示
# 本地 RAG 知识库（内置向量检索，knowledge 意图走本地；不配置 RAG_SERVICE_URL 时无需 rag-qa-system）
KNOWLEDGE_DIR=./knowledge
EMBEDDING_MODEL_PATH=./models/bge-small-zh-v1.5
KNOWLEDGE_TOP_K=5
RAG_SERVICE_URL=

# ===== 天气 API（和风天气 QWeather） =====
# WEATHER_API_PROVIDER: mock（内置演示数据，无需 Key）| qweather（实时天气，需 Key）
WEATHER_API_PROVIDER=mock
WEATHER_API_KEY=
WEATHER_TIMEOUT=10
WEATHER_CACHE_TTL=600

# ===== 数据库与用户体系 =====
# MySQL 连接串（密码含特殊字符需 URL 编码，如 @ -> %40）
DATABASE_URL=mysql+pymysql://ai_agent:your_password@127.0.0.1:3306/ai_agent?charset=utf8mb4
# JWT 签名密钥（生产环境务必更换为随机值）
JWT_SECRET=change_me_to_random_secret
JWT_EXPIRE_HOURS=24
# 头像上传目录（绝对路径）
UPLOAD_DIR=D:\AIAPP\ai-agent\uploads

# ---- 本地 RAG 检索增强（A2）----
KNOWLEDGE_TOP_K_SMALL=3
KNOWLEDGE_TOP_K_LARGE=8
KNOWLEDGE_BM25_WEIGHT=0.3
KNOWLEDGE_MIN_SCORE=0.5
# 重排序模型（bge-reranker-base）下载到 models/ 后置为 true
KNOWLEDGE_RERANK_ENABLED=false
KNOWLEDGE_RERANKER_PATH=<项目根>/models/bge-reranker-base
